# 数据库连接（生产：RDS PostgreSQL；本地开发：pnpm db:dev 启动 PGlite 后用下面这个）
# 注意：PGlite 不支持 SSL，本地必须带 sslmode=disable；生产 RDS 请去掉该参数
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable

# JWT 签名密钥（生产必须换成强随机值）
JWT_SECRET=dev-only-secret-change-me

# 访问令牌有效期（jsonwebtoken 格式）
ACCESS_TOKEN_TTL=2h
# 刷新令牌有效天数
REFRESH_TOKEN_TTL_DAYS=30

# 服务端口
PORT=8787

# CORS 允许来源（* 表示全部；生产建议填具体域名）
CORS_ORIGIN=*
