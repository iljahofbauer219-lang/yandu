  storeId   String                @map("store_id")
  draftId   String                @map("draft_id")
  listingId String                @map("listing_id")
  status    String
  payload   Json
  createdAt String                @map("created_at")
  updatedAt String                @map("updated_at")
  org       Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store     EbayStore             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  draft     EbayOptimizationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([storeId, draftId])
  @@index([storeId, updatedAt(sort: Desc)])
  @@map("ebay_publish_tasks")
}

model EbayAcceptanceBatch {
  id        String       @id
  orgId     String       @map("org_id")
  storeId   String       @map("store_id")
  mode      String
  status    String
  payload   Json
  createdAt String       @map("created_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store     EbayStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@map("ebay_acceptance_batches")
}

model EbayMarketResearch {
  id        String       @id
  orgId     String       @map("org_id")
  storeId   String       @map("store_id")
  listingId String       @map("listing_id")
  payload   Json
  fetchedAt String       @map("fetched_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store     EbayStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, listingId])
  @@index([storeId, fetchedAt(sort: Desc)])
  @@map("ebay_market_research")
}

model EbayMarketResearchHistory {
  id        String       @id
  orgId     String       @map("org_id")
  storeId   String       @map("store_id")
  listingId String       @map("listing_id")
  payload   Json
  fetchedAt String       @map("fetched_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store     EbayStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, listingId, fetchedAt(sort: Desc)])
  @@map("ebay_market_research_history")
}

// ===================== 合规域 =====================
// 注意：compliance_alerts / compliance_enforcement_cases 的“未关闭去重”部分唯一索引在迁移 SQL 中原生补建

model ComplianceSource {
  id            String
  orgId         String                   @map("org_id")
  name          String
  authority     String
  sourceType    String                   @map("source_type")
  url           String
  syncMode      String                   @map("sync_mode")
  syncStatus    String                   @default("NOT_CONFIGURED") @map("sync_status")
  lastSyncedAt  String?                  @map("last_synced_at")
  lastError     String?                  @map("last_error")
  contentHash   String                   @default("") @map("content_hash")
  lastCheckedAt String?                  @map("last_checked_at")
  lastChangedAt String?                  @map("last_changed_at")
  changeCount   Int                      @default(0) @map("change_count")
  org           Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  changes       ComplianceSourceChange[]
  recalls       ComplianceRecall[]

  // 逻辑 id（如 source-ebay）在各组织内重复，主键必须带 orgId
  @@id([orgId, id])
  @@map("compliance_sources")
}

model ComplianceSourceChange {
  id              String           @id
  orgId           String           @map("org_id")
  sourceId        String           @map("source_id")
  oldHash         String           @default("") @map("old_hash")
  newHash         String           @map("new_hash")
  summary         String           @default("")
  affectedRuleIds Json             @default("[]") @map("affected_rule_ids_json")
  status          String           @default("PENDING_REVIEW")
  detectedAt      String           @map("detected_at")
  reviewedAt      String?          @map("reviewed_at")
  reviewedBy      String           @default("") @map("reviewed_by")
  reviewNote      String           @default("") @map("review_note")
  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  source          ComplianceSource @relation(fields: [orgId, sourceId], references: [orgId, id], onDelete: Cascade)

  @@index([sourceId, detectedAt(sort: Desc)])
  @@map("compliance_source_changes")
}

model ComplianceRule {
  id              String                  @id
  orgId           String                  @map("org_id")
  code            String
  platform        String
  marketplaceSite String                  @default("ALL") @map("marketplace_site")
  country         String                  @default("ALL")
  category        String                  @default("ALL")
  ruleType        String                  @map("rule_type")
  riskLevel       String                  @map("risk_level")
  reviewStatus    String                  @default("DRAFT") @map("review_status")
  currentVersion  Int                     @default(1) @map("current_version")
  createdAt       String                  @map("created_at")
  updatedAt       String                  @map("updated_at")
  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions        ComplianceRuleVersion[]

  @@unique([orgId, code])
  @@index([orgId, platform, marketplaceSite, country, reviewStatus])
  @@map("compliance_rules")
}

model ComplianceRuleVersion {
  id            String         @id
  orgId         String         @map("org_id")
  ruleId        String         @map("rule_id")
  version       Int
  title         String
  summary       String
  conditionJson Json           @default("{}") @map("condition_json")
  remediation   String         @default("")
  sourceUrl     String         @map("source_url")
  effectiveFrom String         @map("effective_from")
  createdAt     String         @map("created_at")
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rule          ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@map("compliance_rule_versions")
}

model ComplianceRecall {
  id          String           @id
  orgId       String           @map("org_id")
  sourceId    String           @map("source_id")
  externalId  String           @map("external_id")
  title       String
  description String           @default("")
  products    String           @default("")
  hazards     String           @default("")
  countries   String           @default("")
  recallDate  String           @default("") @map("recall_date")
  sourceUrl   String           @map("source_url")
  updatedAt   String           @map("updated_at")
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  source      ComplianceSource @relation(fields: [orgId, sourceId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, sourceId, externalId])
  @@map("compliance_recalls")
}

model ComplianceCheckRun {
  id               String                    @id
  orgId            String                    @map("org_id")
  productId        String                    @map("product_id")
  platform         String
  marketplaceSite  String                    @map("marketplace_site")
  country          String
  gateStatus       String                    @map("gate_status")
  ruleSetVersion   String                    @map("rule_set_version")
  inputFingerprint String                    @default("") @map("input_fingerprint")
  requestJson      Json                      @default("{}") @map("request_json")
  findingsJson     Json                      @default("[]") @map("findings_json")
  checkedAt        String                    @map("checked_at")
  reviewedAt       String?                   @map("reviewed_at")
  reviewedBy       String?                   @map("reviewed_by")
  reviewNote       String?                   @map("review_note")
  org              Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permits          ComplianceReleasePermit[]

  @@index([orgId, productId, checkedAt(sort: Desc)])
  @@map("compliance_check_runs")
}

model ComplianceProductProfile {
  id                  String               @id
  orgId               String               @map("org_id")
  productId           String               @map("product_id")
  platform            String
  marketplaceSite     String               @map("marketplace_site")
  country             String
  categoryId          String               @default("") @map("category_id")
  categoryName        String               @default("") @map("category_name")
  title               String               @default("")
  brand               String               @default("")
  manufacturer        String               @default("")
  importer            String               @default("")
  euResponsiblePerson String               @default("") @map("eu_responsible_person")
  model               String               @default("")
  batchNumber         String               @default("") @map("batch_number")
  barcode             String               @default("")
  originCountry       String               @default("") @map("origin_country")
  materials           String               @default("")
  ageGrade            String               @default("") @map("age_grade")
  batteryType         String               @default("") @map("battery_type")
  createdAt           String               @map("created_at")
  updatedAt           String               @map("updated_at")
  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents           ComplianceDocument[]

  @@unique([orgId, productId])
  @@map("compliance_product_profiles")
}

model ComplianceDocument {
  id             String                   @id
  orgId          String                   @map("org_id")
  productId      String                   @map("product_id")
  documentType   String                   @map("document_type")
  name           String
  documentNumber String                   @default("") @map("document_number")
  issuer         String                   @default("")
  modelNumbers   String                   @default("") @map("model_numbers")
  countries      String                   @default("")
  issuedAt       String                   @default("") @map("issued_at")
  expiresAt      String                   @default("") @map("expires_at")
  status         String                   @default("PENDING_REVIEW")
  fileName       String                   @default("") @map("file_name")
  filePath       String                   @default("") @map("file_path")
  reviewNote     String                   @default("") @map("review_note")
  createdAt      String                   @map("created_at")
  updatedAt      String                   @map("updated_at")
  org            Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profile        ComplianceProductProfile @relation(fields: [orgId, productId], references: [orgId, productId], onDelete: Cascade)

  @@index([orgId, productId, status, expiresAt])
  @@map("compliance_documents")
}

model ComplianceCategoryTemplate {
  id                        String       @id
  orgId                     String       @map("org_id")
  name                      String
  platform                  String
  marketplaceSite           String       @default("ALL") @map("marketplace_site")
  country                   String       @default("ALL")
  category                  String       @default("ALL")
  requiredFieldsJson        Json         @default("[]") @map("required_fields_json")
  requiredDocumentsJson     Json         @default("[]") @map("required_documents_json")
  requiredWarningsJson      Json         @default("[]") @map("required_warnings_json")
  logisticsRequirementsJson Json         @default("[]") @map("logistics_requirements_json")
  requiresManualReview      Int          @default(0) @map("requires_manual_review")
  active                    Int          @default(1)
  createdAt                 String       @map("created_at")
  updatedAt                 String       @map("updated_at")
  org                       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, platform, marketplaceSite, country, category, active])
  @@map("compliance_category_templates")
}

model ComplianceTask {
  id         String       @id
  orgId      String       @map("org_id")
  productId  String       @map("product_id")
  checkId    String?      @map("check_id")
  taskType   String       @map("task_type")
  riskLevel  String       @map("risk_level")
  title      String
  detail     String       @default("")
  status     String       @default("OPEN")
  assignee   String       @default("")
  dueAt      String       @default("") @map("due_at")
  resolution String       @default("")
  createdAt  String       @map("created_at")
  updatedAt  String       @map("updated_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, riskLevel, updatedAt(sort: Desc)])
  @@map("compliance_tasks")
}

model ComplianceAlert {
  id        String       @id
  orgId     String       @map("org_id")
  alertType String       @map("alert_type")
  riskLevel String       @map("risk_level")
  entityId  String       @map("entity_id")
  title     String
  detail    String       @default("")
  status    String       @default("OPEN")
  note      String       @default("")
  createdAt String       @map("created_at")
  updatedAt String       @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, riskLevel, updatedAt(sort: Desc)])
  @@map("compliance_alerts")
}

model ComplianceAuditEvent {
  id         String       @id
  orgId      String       @map("org_id")
  action     String
  entityType String       @map("entity_type")
  entityId   String       @map("entity_id")
  detail     String       @default("")
  createdAt  String       @map("created_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("compliance_audit_events")
}

model ComplianceReleasePermit {
  id               String             @id
  orgId            String             @map("org_id")
  productId        String             @map("product_id")
  platform         String
  marketplaceSite  String             @map("marketplace_site")
  checkId          String             @map("check_id")
  ruleSetVersion   String             @map("rule_set_version")
  inputFingerprint String             @map("input_fingerprint")
  gateStatus       String             @map("gate_status")
  issuedAt         String             @map("issued_at")
  expiresAt        String             @map("expires_at")
  status           String             @default("VALID")
  revokedAt        String?            @map("revoked_at")
  revokeReason     String             @default("") @map("revoke_reason")
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  check            ComplianceCheckRun @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([orgId, productId, status, expiresAt(sort: Desc)])
  @@map("compliance_release_permits")
}

model ComplianceEnforcementCase {
  id                String       @id
  orgId             String       @map("org_id")
  productId         String       @map("product_id")
  platform          String
  marketplaceSite   String       @map("marketplace_site")
  listingId         String       @default("") @map("listing_id")
  storeId           String       @default("") @map("store_id")
  title             String       @default("")
  viewUrl           String       @default("") @map("view_url")
  riskLevel         String       @map("risk_level")
  reason            String
  recommendedAction String       @map("recommended_action")
  status            String       @default("OPEN")
  assignee          String       @default("")
  resolution        String       @default("")
  resolvedAt        String?      @map("resolved_at")
  createdAt         String       @map("created_at")
  updatedAt         String       @map("updated_at")
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, riskLevel, updatedAt(sort: Desc)])
  @@map("compliance_enforcement_cases")
}
