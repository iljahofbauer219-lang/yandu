generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
  REJECTED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  users       User[]
  roles       Role[]
  stores      EbayStore[]
  auditLogs   AuditLog[]
  aiUsageLogs AiUsageLog[]
  aiQuotas    AiQuota[]

  // ---- 业务域（全部 org 隔离，级联删除） ----
  selectionTasks                 SelectionTask[]
  supplyPlatforms                SupplyPlatform[]
  collectionTaskPlatforms        CollectionTaskPlatform[]
  marketplacePlatforms           MarketplacePlatform[]
  productWarehouses              ProductWarehouse[]
  marketplaceAccounts            MarketplaceAccount[]
  marketplaceAccountCredentials  MarketplaceAccountCredential[]
  taskSelectionRules             TaskSelectionRule[]
  productEvaluations             ProductEvaluation[]
  evaluationEvidences            EvaluationEvidence[]
  productRiskFlags               ProductRiskFlag[]
  productRejectionRecords        ProductRejectionRecord[]
  marketCandidates               MarketCandidate[]
  supplyCandidates               SupplyCandidate[]
  candidateCollectionRuns        CandidateCollectionRun[]
  candidateCollectionRecords     CandidateCollectionRecord[]
  productIntakeRegistries        ProductIntakeRegistry[]
  comparisonRecords              ComparisonRecord[]
  selectionRecords               SelectionRecord[]
  inventoryRecords               InventoryRecord[]
  listingRecords                 ListingRecord[]
  workflowEvents                 WorkflowEvent[]
  purchaseOrders                 PurchaseOrder[]
  reconciliationRecords          ReconciliationRecord[]
  supplyWarehouseProducts        SupplyWarehouseProduct[]
  marketplaceSelectionProducts   MarketplaceSelectionProduct[]
  marketplaceMediaAssets         MarketplaceMediaAsset[]
  marketplacePublishDrafts       MarketplacePublishDraft[]
  marketplacePublishAudits       MarketplacePublishAudit[]
  ebayStoreUrlHistories          EbayStoreUrlHistory[]
  ebayListings                   EbayListing[]
  ebayStoreCategories            EbayStoreCategory[]
  ebayCategorySyncRuns           EbayCategorySyncRun[]
  ebayProductSyncRuns            EbayProductSyncRun[]
  ebayProductSyncCheckpoints     EbayProductSyncCheckpoint[]
  ebayListingAbsenceEvidences    EbayListingAbsenceEvidence[]
  ebayLocalProducts              EbayLocalProduct[]
  ebayLocalProductSnapshots      EbayLocalProductSnapshot[]
  ebayLocalProductMedias         EbayLocalProductMedia[]
  ebayImageVisualInspections     EbayImageVisualInspection[]
  ebayImageVisualReviewEvents    EbayImageVisualReviewEvent[]
  ebayOptimizationDrafts         EbayOptimizationDraft[]
  ebayContentOptimizationRecords EbayContentOptimizationRecord[]
  ebayTitleDecisions             EbayTitleDecision[]
  ebayTitleHandoffs              EbayTitleHandoff[]
  ebayPublishTasks               EbayPublishTask[]
  ebayAcceptanceBatches          EbayAcceptanceBatch[]
  ebayMarketResearches           EbayMarketResearch[]
  ebayMarketResearchHistories    EbayMarketResearchHistory[]
  complianceSources              ComplianceSource[]
  complianceSourceChanges        ComplianceSourceChange[]
  complianceRules                ComplianceRule[]
  complianceRuleVersions         ComplianceRuleVersion[]
  complianceRecalls              ComplianceRecall[]
  complianceCheckRuns            ComplianceCheckRun[]
  complianceProductProfiles      ComplianceProductProfile[]
  complianceDocuments            ComplianceDocument[]
  complianceCategoryTemplates    ComplianceCategoryTemplate[]
  complianceTasks                ComplianceTask[]
  complianceAlerts               ComplianceAlert[]
  complianceAuditEvents          ComplianceAuditEvent[]
  complianceReleasePermits       ComplianceReleasePermit[]
  complianceEnforcementCases     ComplianceEnforcementCase[]

  @@map("organizations")
}

model User {
  id                 String           @id @default(cuid())
  orgId              String           @map("org_id")
  email              String           @unique
  name               String
  passwordHash       String           @map("password_hash")
  isOwner            Boolean          @default(false) @map("is_owner")
  status             UserStatus       @default(ACTIVE)
  mustChangePassword Boolean          @default(false) @map("must_change_password")
  lastLoginAt        DateTime?        @map("last_login_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  org                Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roles              UserRole[]
  storeGrants        UserStoreGrant[]
  refreshTokens      AuthToken[]
  auditLogs          AuditLog[]
  aiUsageLogs        AiUsageLog[]
  aiQuotas           AiQuota[]

  preferredLinduoModelId String?           @map("preferred_linduo_model_id")
  linduoGrants           UserLinduoGrant[]

  @@index([orgId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  orgId       String           @map("org_id")
  key         String?
  name        String
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([orgId, name])
  @@unique([orgId, key])
  @@index([orgId])
  @@map("roles")
}

model RolePermission {
  roleId String @map("role_id")
  code   String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, code])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model EbayStore {
  id                         String                          @id @default(cuid())
  orgId                      String                          @map("org_id")
  name                       String
  sellerId                   String                          @default("") @map("seller_id")
  marketplaceId              String                          @default("EBAY_US") @map("marketplace_id")
  // PENDING（待授权）/ CONNECTED / ERROR
  status                     String                          @default("PENDING")
  encryptedAccessToken       String                          @default("") @map("encrypted_access_token")
  encryptedRefreshToken      String                          @default("") @map("encrypted_refresh_token")
  accessTokenExpiresAt       String?                         @map("access_token_expires_at")
  refreshTokenExpiresAt      String?                         @map("refresh_token_expires_at")
  lastSyncAt                 String?                         @map("last_sync_at")
  syncError                  String?                         @map("sync_error")
  publicStoreUrl             String                          @default("") @map("public_store_url")
  publicStoreVerifiedAt      String?                         @map("public_store_verified_at")
  createdAt                  DateTime                        @default(now()) @map("created_at")
  updatedAt                  DateTime                        @updatedAt @map("updated_at")
  org                        Organization                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grants                     UserStoreGrant[]
  urlHistories               EbayStoreUrlHistory[]
  listings                   EbayListing[]
  storeCategories            EbayStoreCategory[]
  categorySyncRuns           EbayCategorySyncRun[]
  productSyncRuns            EbayProductSyncRun[]
  productSyncCheckpoints     EbayProductSyncCheckpoint[]
  listingAbsenceEvidences    EbayListingAbsenceEvidence[]
  localProducts              EbayLocalProduct[]
  optimizationDrafts         EbayOptimizationDraft[]
  contentOptimizationRecords EbayContentOptimizationRecord[]
  titleDecisions             EbayTitleDecision[]
  titleHandoffs              EbayTitleHandoff[]
  publishTasks               EbayPublishTask[]
  acceptanceBatches          EbayAcceptanceBatch[]
  marketResearches           EbayMarketResearch[]
  marketResearchHistories    EbayMarketResearchHistory[]

  @@index([orgId])
  @@map("ebay_stores")
}

model UserStoreGrant {
  userId  String    @map("user_id")
  storeId String    @map("store_id")
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   EbayStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
  @@map("user_store_grants")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model AuditLog {
  id         String       @id @default(cuid())
  orgId      String       @map("org_id")
  userId     String?      @map("user_id")
  action     String
  targetType String?      @map("target_type")
  targetId   String?      @map("target_id")
  detail     Json?
  ip         String?
  createdAt  DateTime     @default(now()) @map("created_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model AiUsageLog {
  id        String       @id @default(cuid())
  orgId     String       @map("org_id")
  userId    String?      @map("user_id")
  provider  String
  model     String
  purpose   String
  units     Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("ai_usage_logs")
}

model AiQuota {
  id         String       @id @default(cuid())
  orgId      String       @map("org_id")
  userId     String       @map("user_id")
  // 月度配额上限：null = 不限；0 = 完全禁止
  imageLimit Int?         @map("image_limit")
  videoLimit Int?         @map("video_limit")
  textLimit  Int?         @map("text_limit")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("ai_quotas")
}

// ===================== 零度API 模型价格抓取（api000.com/pricing） =====================
// 抓取脚本通过 playwright + 用户名密码自动登录后，从 /pricing 页面提取 37 个模型的价格；
// 每天 06:00 调度一次。LinduoModelPricing 存储结构化的价格，LinduoLoginSession 保存登录态。

model LinduoModelPricing {
  id           String   @id @default(cuid())
  // 零度API 模型 id，与 LinduoModelMallPage 静态目录严格一致
  modelId      String   @unique @map("model_id")
  // openai / google / anthropic / vidu
  vendor       String
  // 美元 / 1M tokens（token 计费模型）
  inputPrice   Float?   @map("input_price")
  // 美元 / 1M tokens
  outputPrice  Float?   @map("output_price")
  // 美元 / 1M tokens（缓存读，可选）
  cachePrice   Float?   @map("cache_price")
  currency     String   @default("USD")
  // TOKEN | IMAGE | VIDEO | REQUEST
  billingType  String   @default("TOKEN") @map("billing_type")
  // 图片/视频按张/按秒计费时存储单次价格
  pricePerUnit Float?   @map("price_per_unit")
  // 1M tokens / 张 / 秒
  unitLabel    String?  @map("unit_label")
  fetchedAt    DateTime @map("fetched_at")
  // true = 上次抓取失败后保留的旧数据
  stale        Boolean  @default(false)
  raw          String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([vendor])
  @@map("linduo_model_pricing")
}

model LinduoLoginSession {
  id          String    @id @default(cuid())
  username    String
  // AES-256-GCM 加密后的密码；用于 cookie 失效时自动重新登录
  passwordEnc String    @map("password_enc")
  // 序列化后的 cookie 数组
  cookies     String
  // cookie 预计过期时间；早于当前 +24h 视为即将过期，会自动重新登录
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("linduo_login_sessions")
}

// ===================== Linduo 聊天模型选用 (M1) =====================
// 启动时跟 src/shared/linduoCatalog.ts 的 LINDUO_MODELS 静态目录对账:
// - 静态新增 modelId → INSERT enabled=true
// - 静态已有但 displayName/description 变化 → UPDATE
// - 静态移除 modelId → UPDATE enabled=false (软关,保留 grants 历史)

model LinduoChatModel {
  id           String            @id @default(cuid())
  /// 零度API 模型 id，与 LinduoModelMallPage 静态目录严格一致
  modelId      String            @unique @map("model_id")
  /// openai / google / anthropic
  vendor       String
  /// UI 展示名
  displayName  String            @map("display_name")
  description  String?
  /// 128K / 1M 等
  contextLabel String?           @map("context_label")
  /// JSON 字符串，如 ["CHAT","VISION"]
  capabilities String            @default("[]")
  /// 推理深度 low/medium/high/max；M1 全部默认 medium
  effort       String            @default("medium")
  enabled      Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  grants       UserLinduoGrant[]

  @@index([vendor])
  @@map("linduo_chat_models")
}

model UserLinduoGrant {
  userId    String          @map("user_id")
  modelId   String          @map("model_id")
  grantedBy String?         @map("granted_by")
  grantedAt DateTime        @default(now()) @map("granted_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     LinduoChatModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([userId, modelId])
  @@index([modelId])
  @@map("user_linduo_grants")
}

// ===================== 选品 / 采集域（自 SQLite 平移，时间列保持 ISO8601 字符串） =====================

model SelectionTask {
  id               String                   @id
  orgId            String                   @map("org_id")
  payload          Json
  stage            String
  createdAt        String                   @map("created_at")
  org              Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  platforms        CollectionTaskPlatform[]
  selectionRule    TaskSelectionRule?
  evaluations      ProductEvaluation[]
  rejectionRecords ProductRejectionRecord[]
  supplyCandidates SupplyCandidate[]
  comparisons      ComparisonRecord[]
  selections       SelectionRecord[]
  inventoryRecords InventoryRecord[]
  listingRecords   ListingRecord[]

  @@index([orgId])
  @@map("selection_tasks")
}

model SupplyPlatform {
  orgId           String                   @map("org_id")
  code            String
  name            String
  connectorStatus String                   @default("PLANNED") @map("connector_status")
  sortOrder       Int                      @default(0) @map("sort_order")
  org             Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taskPlatforms   CollectionTaskPlatform[]

  @@id([orgId, code])
  @@map("supply_platforms")
}

model CollectionTaskPlatform {
  taskId       String         @map("task_id")
  orgId        String         @map("org_id")
  platformCode String         @map("platform_code")
  status       String         @default("PENDING")
  createdAt    String         @map("created_at")
  task         SelectionTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  platform     SupplyPlatform @relation(fields: [orgId, platformCode], references: [orgId, code])
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([taskId, platformCode])
  @@map("collection_task_platforms")
}

model MarketplacePlatform {
  orgId                  String               @map("org_id")
  code                   String
  name                   String
  homeUrl                String               @map("home_url")
  defaultNetworkStrategy String               @default("LOCAL_DIRECT") @map("default_network_strategy")
  collectorReady         Int                  @default(0) @map("collector_ready")
  enabled                Int                  @default(1)
  org                    Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accounts               MarketplaceAccount[]

  @@id([orgId, code])
  @@map("marketplace_platforms")
}

model ProductWarehouse {
  orgId         String       @map("org_id")
  code          String
  name          String
  warehouseKind String       @map("warehouse_kind")
  ruleProfile   Json         @default("[]") @map("rule_profile")
  enabled       Int          @default(1)
  updatedAt     String       @map("updated_at")
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, code])
  @@map("product_warehouses")
}

model MarketplaceAccount {
  id              String              @id
  orgId           String              @map("org_id")
  platformCode    String              @map("platform_code")
  name            String
  networkStrategy String              @default("LOCAL_DIRECT") @map("network_strategy")
  status          String              @default("ACTIVE")
  createdAt       String              @map("created_at")
  updatedAt       String              @map("updated_at")
  org             Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  platform        MarketplacePlatform @relation(fields: [orgId, platformCode], references: [orgId, code])

  @@index([orgId])
  @@map("marketplace_accounts")
}

model MarketplaceAccountCredential {
  accountId         String       @id @map("account_id")
  orgId             String       @map("org_id")
  platformCode      String       @map("platform_code")
  username          String       @default("")
  encryptedPassword String       @default("") @map("encrypted_password")
  automationMode    String       @default("SESSION_ONLY") @map("automation_mode")
  updatedAt         String       @map("updated_at")
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("marketplace_account_credentials")
}

model TaskSelectionRule {
  taskId       String        @id @map("task_id")
  orgId        String        @map("org_id")
  platformCode String        @map("platform_code")
  presetCode   String        @map("preset_code")
  minimumScore Float         @default(65) @map("minimum_score")
  dimensions   Json          @default("[]")
  weights      Json          @default("{}")
  criteria     Json          @default("{}")
  createdAt    String        @map("created_at")
  task         SelectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("task_selection_rules")
}

model ProductEvaluation {
  id               String               @id
  orgId            String               @map("org_id")
  taskId           String               @map("task_id")
  productUrl       String               @map("product_url")
  totalScore       Float?               @map("total_score")
  grade            String?
  dataCompleteness Float?               @map("data_completeness")
  dimensionScores  Json                 @default("{}") @map("dimension_scores")
  recommendation   String?
  evaluatedAt      String               @map("evaluated_at")
  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task             SelectionTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  evidences        EvaluationEvidence[]
  riskFlags        ProductRiskFlag[]

  @@index([taskId, totalScore])
  @@map("product_evaluations")
}

model EvaluationEvidence {
  id            String            @id
  orgId         String            @map("org_id")
  evaluationId  String            @map("evaluation_id")
  dimensionCode String            @map("dimension_code")
  evidenceType  String            @map("evidence_type")
  sourceUrl     String?           @map("source_url")
  content       String
  scoreEffect   Float?            @map("score_effect")
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  evaluation    ProductEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("evaluation_evidence")
}

model ProductRiskFlag {
  id           String            @id
  orgId        String            @map("org_id")
  evaluationId String            @map("evaluation_id")
  riskCode     String            @map("risk_code")
  severity     String
  detail       String
  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  evaluation   ProductEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("product_risk_flags")
}

model ProductRejectionRecord {
  id         String        @id
  orgId      String        @map("org_id")
  taskId     String        @map("task_id")
  productUrl String        @map("product_url")
  reasonCode String        @map("reason_code")
  reason     String
  createdAt  String        @map("created_at")
  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task       SelectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("product_rejection_records")
}

model MarketCandidate {
  orgId        String       @map("org_id")
  platformCode String       @map("platform_code")
  productId    String       @default("") @map("product_id")
  url          String
  firstTaskId  String       @map("first_task_id")
  latestTaskId String       @map("latest_task_id")
  payload      Json
  collectedAt  String       @map("collected_at")
  updatedAt    String       @map("updated_at")
  deletedAt    String?      @map("deleted_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, platformCode, url])
  @@index([orgId, platformCode, updatedAt(sort: Desc)])
  @@map("market_candidates")
}

model SupplyCandidate {
  taskId    String        @map("task_id")
  orgId     String        @map("org_id")
  url       String
  payload   Json
  score     Float         @default(0)
  selected  Int           @default(0)
  sortOrder Int           @map("sort_order")
  deletedAt String?       @map("deleted_at")
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task      SelectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, url])
  @@index([taskId, selected, score])
  @@index([orgId])
  @@map("supply_candidates")
}

model CandidateCollectionRun {
  id               String                      @id
  orgId            String                      @map("org_id")
  taskId           String                      @map("task_id")
  candidateArea    String                      @map("candidate_area")
  platformCode     String                      @map("platform_code")
  collectionMethod String                      @map("collection_method")
  sourceEntry      String                      @default("") @map("source_entry")
  requestedCount   Int                         @default(0) @map("requested_count")
  collectedCount   Int                         @default(0) @map("collected_count")
  newCount         Int                         @default(0) @map("new_count")
  updatedCount     Int                         @default(0) @map("updated_count")
  selectedCount    Int                         @default(0) @map("selected_count")
  status           String                      @default("COMPLETED")
  startedAt        String                      @map("started_at")
  completedAt      String                      @map("completed_at")
  org              Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  records          CandidateCollectionRecord[]

  @@index([orgId, candidateArea, completedAt(sort: Desc)])
  @@map("candidate_collection_runs")
}

model CandidateCollectionRecord {
  collectionRunId  String                 @map("collection_run_id")
  orgId            String                 @map("org_id")
  candidateArea    String                 @map("candidate_area")
  candidateKey     String                 @map("candidate_key")
  platformCode     String                 @map("platform_code")
  collectionMethod String                 @map("collection_method")
  sourceEntry      String                 @default("") @map("source_entry")
  sourceRank       Int                    @default(0) @map("source_rank")
  collectedAt      String                 @map("collected_at")
  run              CandidateCollectionRun @relation(fields: [collectionRunId], references: [id], onDelete: Cascade)
  org              Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([collectionRunId, candidateArea, candidateKey])
  @@index([orgId, candidateArea, candidateKey, collectedAt(sort: Desc)])
  @@map("candidate_collection_records")
}

model ProductIntakeRegistry {
  orgId              String       @map("org_id")
  identityKey        String       @map("identity_key")
  platformCode       String       @map("platform_code")
  productId          String       @default("") @map("product_id")
  canonicalUrl       String       @default("") @map("canonical_url")
  titleSnapshot      String       @default("") @map("title_snapshot")
  firstCollectedAt   String       @map("first_collected_at")
  lastSeenAt         String       @map("last_seen_at")
