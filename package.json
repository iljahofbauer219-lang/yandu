{
  "name": "cross-border-sourcing-desktop",
  "version": "1.0.17",
  "private": true,
  "description": "砚都跨境·跨境电商选品与素材工作台",
  "author": "砚都跨境",
  "main": "dist/main/main/boot/boot.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist/main/main/main.js && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.main.json",
    "rebuild:clean": "rm -rf dist build node_modules/.vite && vite build && tsc -p tsconfig.main.json",
    "verify:markers": "node tools/check-source-markers.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "hot:sync": "node tools/sync-hot.mjs",
    "hot:off": "node tools/sync-hot.mjs --off",
    "lint:catalog": "node scripts/check-linduo-catalog-consistency.mjs",
    "verify:j": "tsx tools/verify-j-stage.ts",
    "verify:j7": "tsx tools/verify-j7-regression.ts",
    "verify:k": "tsx tools/verify-k-stage.ts",
    "start": "electron .",
    "desktop": "npm run build && npm start",
    "dist": "npm run build && electron-builder --mac --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "postdist:mac": "codesign --force --deep --sign - \"release/mac/砚都跨境.app\" && codesign --verify --deep --verbose=2 \"release/mac/砚都跨境.app\" && (xattr -cr \"release/mac/砚都跨境.app\" || xattr -c \"release/mac/砚都跨境.app\" || true)",
    "dist:win": "npm run build && electron-builder --win",
    "release:publish": "node tools/publish-release.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/darwin-x64": "^4.1.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "@larksuiteoapi/node-sdk": "^1.70.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.7.3",
    "iconv-lite": "^0.7.3",
    "mammoth": "^1.12.0",
    "officeparser": "^7.8.0",
    "pdf-parse": "^1.1.1",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "43.1.0",
    "electron-builder": "^26.7.0",
    "typescript": "~5.7.2",
    "vite": "8.1.4",
    "vitest": "^4.1.11",
    "wait-on": "latest"
  }
}
