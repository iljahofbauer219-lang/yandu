# eBay Production OAuth（正式环境）
# 从 eBay Developer Program > Application Keys > Production 获取。
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

# 火山方舟视频生成（只在 .env.local 中填写真实密钥）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
# 只有在控制台开通并验证后，才把其它模型加入逗号分隔列表。
ARK_VIDEO_MODELS=doubao-seedance-2-0-260128
ARK_TEXT_MODELS=

# 豆包语音合成 2.0（V3 HTTP；凭证为空时页面禁用且后端拒绝）
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_NATURAL_FEMALE=zh_female_vv_uranus_bigtts
VOLC_TTS_VOICE_NATURAL_MALE=zh_male_dayi_saturn_bigtts
VOLC_TTS_VOICE_PROFESSIONAL_FEMALE=
VOLC_TTS_VOICE_PROFESSIONAL_MALE=

# MaxKB 智体总入口（v2.10.5-lts CE，部署于中央服务器 8080 端口）
# APPLICATION_ID / TOKEN / SECRET / KNOWLEDGE_DATASETS 详细段在 .env.local 维护
MAXKB_BASE_URL=http://114.55.149.192:8080
MAXKB_ADMIN_PASSWORD=

# 零度API（api000.com）：一把 Key 聚合 37 个大模型（OpenAI / Anthropic / Google / Vidu）
# 兼容 OpenAI 协议：/v1/models、/v1/chat/completions、/v1/images/generations
# 在 AI 总部 → 大模型API Key → 零度API 卡片配置；留空保存 = 清除
LINDUO_BASE_URL=https://api000.com/v1
LINDUO_API_KEY=

# 零度API 价格抓取（playwright-core 驱动）
# 用户名+密码用于自动登录后从 /pricing 页面抓取 37 个模型的价格
# 密码以 AES-256-GCM 加密后入库；密钥可用 `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"` 生成
LINDUO_PRICING_BASE_URL=https://api000.com
LINDUO_PRICING_USERNAME=
LINDUO_PRICING_PASSWORD=
LINDUO_PRICING_AES_KEY=
# 本地 Chrome 路径（macOS 默认 /Applications/Google Chrome.app/Contents/MacOS/Google Chrome，可不填）
LINDUO_PRICING_CHROME_PATH=
# 每日抓取时间（小时，0-23，默认 6）
LINDUO_PRICING_REFRESH_HOUR=6
